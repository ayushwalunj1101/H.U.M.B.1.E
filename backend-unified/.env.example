# Unified Backend — Environment Variables
# Copy to .env and fill in your API keys

# LLM (Required)
GROQ_API_KEY=your_groq_key

# HeyGen Avatar (Required for avatar flow)
HEYGEN_API_KEY=your_heygen_key

# Deepgram (Required for voice WebSocket flow)
DEEPGRAM_API_KEY=your_deepgram_key

# Google Gemini (Required for memory embeddings + journal analysis)
GEMINI_API_KEY=your_gemini_key

# MongoDB Atlas (Optional — memory features disabled if not set)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/solace?retryWrites=true&w=majority

# TTS Voice
TTS_VOICE=aura-asteria-en

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
